   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Preparing RIS closed-form series core...\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"betaD", "[", 
      RowBox[{"gdB_", "?", "NumericQ"}], "]"}], ":=", 
