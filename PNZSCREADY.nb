          RowBox[{"Gamma", "[", "cM", "]"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GammaRegularized", "[", 
           RowBox[{
            RowBox[{"cM", "+", "j"}], ",", "0", ",", "b"}], "]"}], "-", 
          RowBox[{"GammaRegularized", "[", 
           RowBox[{
            RowBox[{"cM", "+", "j"}], ",", "0", ",", "a"}], "]"}]}], ")"}]}], 
       ",", "40"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"noRISScaledMomentT", "[", 
      RowBox[{"j_Integer", ",", 
       RowBox[{"a_", "?", "NumericQ"}], ",", 
       RowBox[{"b_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mid", ",", "half", ",", "ell"}], "}"}], ",", 
       RowBox[{
        RowBox[{"mid", "=", 
         RowBox[{"0.5", "*", 
          RowBox[{"(", 
           RowBox[{"a", "+", "b"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"half", "=", 
         RowBox[{"0.5", "*", 
          RowBox[{"(", 
           RowBox[{"b", "-", "a"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Binomial", "[", 
             RowBox[{"j", ",", "ell"}], "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "mid"}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"j", "-", "ell"}], ")"}]}], " ", 
            RowBox[{"noRISRawMomentT", "[", 
             RowBox[{"ell", ",", "a", ",", "b"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"ell", ",", "0", ",", "j"}], "}"}]}], "]"}], "/", 
         RowBox[{"half", "^", "j"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nodeTableNoRIS", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"noRISLocalTNodes", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "numIntervalsNoRIS"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
