             RowBox[{"nodeTableNoRIS", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"coeffs", "=", 
            RowBox[{"Quiet", "[", 
             RowBox[{
              RowBox[{"LinearSolve", "[", 
               RowBox[{"vanderSNoRIS", ",", "vals"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"LinearSolve", "::", "luc"}], ",", 
                RowBox[{"General", "::", "stop"}]}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"total", "+=", 
            RowBox[{"coeffs", ".", 
