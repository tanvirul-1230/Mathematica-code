   RowBox[{
    RowBox[{"highNs", "=", 
     RowBox[{"Keys", "[", "highFromDB", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<Precomputing RIS moment coefficients for high-SNR complement \
branch...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"momentCoeffAssoc", "=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"nE", "=", "nE"}], ",", 
            RowBox[{"kmax", "=", 
             RowBox[{"kMomentRIS", "[", "nE", "]"}]}]}], "}"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<  moment coefficients: Ne = \>\"", ",", "nE", ",", 
             "\"\<, power = \>\"", ",", 
             RowBox[{"nE", "-", "1"}], ",", "\"\<, K = \>\"", ",", "kmax"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"nE", "->", 
            RowBox[{"positivePowerCoeffs", "[", 
             RowBox[{"lambdaE", ",", 
              RowBox[{"nE", "-", "1"}], ",", "kmax", ",", "wpRIS"}], 
             "]"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"nE", ",", "highNs"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"risMomentMaxEveSeries", "[", 
      RowBox[{
       RowBox[{"nE_Integer", "?", "Positive"}], ",", 
       RowBox[{"ell_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "s", ",", "coeffs", ",", "kmax", ",", "logTerms", ",", "maxLog", ",", 
         "val", ",", "r", ",", "le"}], "}"}], ",", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"lambdaD", "+", "ell"}], ",", "wpRIS"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"le", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"lambdaE", ",", "wpRIS"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nE", "==", "1"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Gamma", "[", 
               RowBox[{"le", "+", "s"}], "]"}], "/", 
              RowBox[{"Gamma", "[", "le", "]"}]}], ",", "wpRIS"}], "]"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"coeffs", "=", 
         RowBox[{"momentCoeffAssoc", "[", "nE", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kmax", "=", 
         RowBox[{
          RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logTerms", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", 
                 RowBox[{"r", "+", "1"}], "]"}], "]"}], ",", "wpRIS"}], "]"}],
              "]"}], "+", 
            RowBox[{"Log", "[", "nE", "]"}], "-", 
            RowBox[{"LogGamma", "[", "le", "]"}], "+", 
            RowBox[{"LogGamma", "[", 
             RowBox[{"s", "+", 
              RowBox[{"nE", "*", "le"}], "+", "r"}], "]"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"s", "+", 
