     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"betaD", "[", "gdB", "]"}], "/", "betaE"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kMaxRIS", "[", "nE_Integer", "]"}], ":=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"kMaxRISByN", ",", "nE", ",", "1800"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kMomentRIS", "[", "nE_Integer", "]"}], ":=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"kMomentByN", ",", "nE", ",", "1600"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"polyMultiplyTrunc", ",", "positivePowerCoeffs"}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"polyMultiplyTrunc", "[", 
      RowBox[{"a_List", ",", "b_List", ",", 
       RowBox[{"kmax_Integer", "?", "NonNegative"}], ",", "wp_Integer"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"la", ",", "lb", ",", "maxr", ",", "res"}], "}"}], ",", 
       RowBox[{
        RowBox[{"la", "=", 
         RowBox[{"Length", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"lb", "=", 
         RowBox[{"Length", "[", "b", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"maxr", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"kmax", ",", 
           RowBox[{"la", "+", "lb", "-", "2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], " ", 
              RowBox[{"b", "[", 
               RowBox[{"[", 
                RowBox[{"r", "-", "i", "+", "1"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"r", "-", 
                  RowBox[{"(", 
                   RowBox[{"lb", "-", "1"}], ")"}]}]}], "]"}], ",", 
               RowBox[{"Min", "[", 
                RowBox[{"r", ",", 
                 RowBox[{"la", "-", "1"}]}], "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "0", ",", "maxr"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"N", "[", 
          RowBox[{"res", ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "res", "]"}], "<", 
           RowBox[{"kmax", "+", "1"}]}], ",", 
          RowBox[{"Join", "[", 
           RowBox[{"res", ",", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{"SetPrecision", "[", 
               RowBox[{"0", ",", "wp"}], "]"}], ",", 
              RowBox[{"kmax", "+", "1", "-", 
               RowBox[{"Length", "[", "res", "]"}]}]}], "]"}]}], "]"}], ",", 
          "res"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"positivePowerCoeffs", "[", 
      RowBox[{
       RowBox[{"le_", "?", "NumericQ"}], ",", 
       RowBox[{"nPow_Integer", "?", "NonNegative"}], ",", 
       RowBox[{"kmax_Integer", "?", "NonNegative"}], ",", "wp_Integer"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "result", ",", "base", ",", "power"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nPow", "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"SetPrecision", "[", 
               RowBox[{"1", ",", "wp"}], "]"}], "}"}], ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"SetPrecision", "[", 
                RowBox[{"0", ",", "wp"}], "]"}], ",", "kmax"}], "]"}]}], 
            "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"q", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"1", "/", 
              RowBox[{"Gamma", "[", 
               RowBox[{
                RowBox[{"SetPrecision", "[", 
                 RowBox[{"le", ",", "wp"}], "]"}], "+", "r", "+", "1"}], 
               "]"}]}], ",", "wp"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "0", ",", "kmax"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"{", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"1", ",", "wp"}], "]"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"base", "=", "q"}], ";", "\[IndentingNewLine]", 
        RowBox[{"power", "=", "nPow"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"power", ">", "0"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OddQ", "[", "power", "]"}], ",", 
             RowBox[{"result", "=", 
              RowBox[{"polyMultiplyTrunc", "[", 
               RowBox[{"result", ",", "base", ",", "kmax", ",", "wp"}], 
               "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"power", "=", 
            RowBox[{"Quotient", "[", 
             RowBox[{"power", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"power", ">", "0"}], ",", 
             RowBox[{"base", "=", 
              RowBox[{"polyMultiplyTrunc", "[", 
               RowBox[{"base", ",", "base", ",", "kmax", ",", "wp"}], 
               "]"}]}]}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        "result"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "risSeriesPNZSC", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"risSeriesPNZSC", "[", 
      RowBox[{
       RowBox[{"gdB_", "?", "NumericQ"}], ",", 
       RowBox[{"nE_Integer", "?", "Positive"}], ",", "coeffs_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rho", ",", "kmax", ",", "logTerms", ",", "maxLog", ",", "val", ",", 
         "r", ",", "ld", ",", "le"}], "}"}], ",", 
       RowBox[{
        RowBox[{"rho", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"rhoRoot", "[", "gdB", "]"}], ",", "wpRIS"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"ld", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"lambdaD", ",", "wpRIS"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"le", "=", 
         RowBox[{"SetPrecision", "[", 
