        "\[IndentingNewLine]", 
        RowBox[{"kmax", "=", 
         RowBox[{
          RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logTerms", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", 
                 RowBox[{"r", "+", "1"}], "]"}], "]"}], ",", "wpRIS"}], "]"}],
              "]"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"nE", "*", "le"}], "+", "r"}], ")"}], " ", 
             RowBox[{"Log", "[", "rho", "]"}]}], "+", 
            RowBox[{"LogGamma", "[", 
             RowBox[{"ld", "+", 
              RowBox[{"nE", "*", "le"}], "+", "r"}], "]"}], "-", 
            RowBox[{"LogGamma", "[", "ld", "]"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"ld", "+", 
               RowBox[{"nE", "*", "le"}], "+", "r"}], ")"}], " ", 
             RowBox[{"Log", "[", 
              RowBox[{"1", "+", 
               RowBox[{"nE", "*", "rho"}]}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "0", ",", "kmax"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxLog", "=", 
         RowBox[{"Max", "[", "logTerms", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"val", "=", 
         RowBox[{
          RowBox[{"Exp", "[", "maxLog", "]"}], " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Exp", "[", 
            RowBox[{"logTerms", "-", "maxLog"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Clip", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"val", ",", "20"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"High", "-", 
