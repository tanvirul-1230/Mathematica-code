       RowBox[{"tailMassNoRIS", ",", "4"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "noRISPNZSCAnalytical", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"noRISPNZSCAnalytical", "[", 
      RowBox[{
       RowBox[{"rhoMDB_", "?", "NumericQ"}], ",", "nE_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rhoMbar", ",", 
         RowBox[{"total", "=", "0.0"}], ",", "vals", ",", "coeffs", ",", 
         "i"}], "}"}], ",", 
       RowBox[{
        RowBox[{"rhoMbar", "=", 
         RowBox[{"dB2lin", "[", "rhoMDB", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
